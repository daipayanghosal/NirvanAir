# NirvanAir Environment Variables Configuration

# Google Gemini API Key (Required for live GenAI reasoning; fallback heuristic engine activates if not set)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAQ API Key (Optional v3 token for extended ground station metadata)
OPENAQ_API_KEY=

# Server Port (Default: 8000)
PORT=8000

# Debug Mode
DEBUG=true
